<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LighTouch.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="875"
        x:Class="LighTouch.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/lightouch-logo-cropped.png"
        Title="LighTouch"
        Width="1150"
        Height="875"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#301d55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width" Value="480"/>
        </Style>
        
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1d1136"/>
        </Style>
        
        <Style Selector="Button.secondary">
            <Setter Property="Width" Value="350"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Styles>

    <!-- Fond avec dégradé -->
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1" RadiusY="1">
                <GradientStop Color="#d8d2d2" Offset="0"/>
                <GradientStop Color="#f3f3f3" Offset="0.8"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" 
                       Margin="0,60,0,40" Spacing="20">
                
                <!-- Logo -->
                <Image Source="/Assets/lightouch-logo-cropped.png"
                      Width="80" Height="80"
                      HorizontalAlignment="Center"/>
                
                <!-- Titre -->
                <TextBlock Text="LighTouch" 
                          FontSize="60" 
                          FontWeight="Bold"
                          HorizontalAlignment="Center"
                          Foreground="#1d1136"/>
                
                <!-- Bouton Calibration -->
                <Button Content="Calibration" 
                       Command="{Binding CalibrateCommand}"
                       IsEnabled="False"
                       ToolTip.Tip="Disponible prochainement"/>
                
                <!-- Bouton Onboarding -->
                <Button Content="Onboarding"
                       Command="{Binding OnboardingCommand}"
                       IsEnabled="False"
                       ToolTip.Tip="Disponible prochainement"/>
                
                <!-- Boutons paramètres en ligne -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           Spacing="15"
                           Margin="0,10,0,0">
                    <Button Content="Démarrer service" 
                           Command="{Binding StartServiceCommand}"
                           Classes="secondary"
                           Width="350"/>
                    <Button Content="Arrêter service" 
                           Command="{Binding StopServiceCommand}"
                           Classes="secondary"
                           Width="350"/>
                </StackPanel>
                
                <!-- Status de connexion -->
                <Border Background="#f3f3f3"
                       BorderBrush="#1d1136"
                       BorderThickness="2"
                       CornerRadius="8"
                       Padding="20"
                       Width="480"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Status}" 
                                  FontSize="18"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"
                                  Foreground="#9a3412"/>
                        
                        <TextBlock Text="{Binding ServerInfo}" 
                                  FontSize="14"
                                  HorizontalAlignment="Center"
                                  Foreground="#1d1136"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- Section Logs (pliable) -->
                <Border Background="#e0e0e0"
                       BorderBrush="#1d1136"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="15"
                       Width="700"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📋 Logs système" 
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Foreground="#1d1136"/>
                        
                        <ScrollViewer Height="200" 
                                     Background="White"
                                     CornerRadius="4">
                            <TextBlock Text="{Binding Logs}" 
                                      TextWrapping="Wrap"
                                      FontFamily="Courier New"
                                      FontSize="11"
                                      Foreground="#333"
                                      Padding="10"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Lien Documentation en bas à droite -->
        <TextBlock Text="📚 Documentation"
                  FontSize="14"
                  Foreground="#ffb920"
                  TextDecorations="Underline"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Right"
                  Margin="0,0,20,20"
                  Cursor="Hand"
                  ToolTip.Tip="Cliquez pour ouvrir la documentation">
            <TextBlock.Styles>
                <Style Selector="TextBlock:pointerover">
                    <Setter Property="Foreground" Value="#e09900"/>
                </Style>
            </TextBlock.Styles>
        </TextBlock>
    </Grid>

</Window>
