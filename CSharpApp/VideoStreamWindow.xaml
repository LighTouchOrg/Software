<Window x:Class="LighTouch.VideoStreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LighTouch - Video Stream"
        Width="640"
        Height="480"
        MinWidth="320"
        MinHeight="240"
        Background="#1a1a2e"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#16213e" Padding="10">
            <TextBlock x:Name="headerText"
                       Text="Video Stream"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Video Display -->
        <Border Grid.Row="1" Background="#0f0f23" Margin="5">
            <Grid>
                <!-- Connection status overlay -->
                <TextBlock x:Name="statusText"
                           Text="Connecting to video stream..."
                           Foreground="#888"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Visible"/>

                <!-- Video frame -->
                <Image x:Name="videoImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
            </Grid>
        </Border>

        <!-- Footer with status -->
        <Border Grid.Row="2" Background="#16213e" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="connectionStatus"
                           Grid.Column="0"
                           Text="Disconnected"
                           Foreground="#e94560"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="fpsText"
                           Grid.Column="1"
                           Text=""
                           Foreground="#888"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
