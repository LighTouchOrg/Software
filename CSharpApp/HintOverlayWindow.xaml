<Window x:Class="LighTouch.HintOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HintOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        Focusable="False">
    
    <Window.Resources>
        <!-- Easing functions -->
        <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <QuadraticEase x:Key="EaseIn" EasingMode="EaseIn"/>
        <QuadraticEase x:Key="EaseInOut" EasingMode="EaseInOut"/>
        
        <!-- Animation d'apparition (fade in + scale) -->
        <Storyboard x:Key="ShowHintAnimation">
            <DoubleAnimation Storyboard.TargetName="HintContainer"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.4"
                           EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                           Storyboard.TargetProperty="ScaleX"
                           From="0.8" To="1" Duration="0:0:0.4"
                           EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                           Storyboard.TargetProperty="ScaleY"
                           From="0.8" To="1" Duration="0:0:0.4"
                           EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
        
        <!-- Animation de disparition (fade out) -->
        <Storyboard x:Key="HideHintAnimation">
            <DoubleAnimation Storyboard.TargetName="HintContainer"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.3"
                           EasingFunction="{StaticResource EaseIn}"/>
        </Storyboard>
        
        <!-- Animation pulsation statique -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HandScaleTransform"
                           Storyboard.TargetProperty="ScaleX"
                           From="1" To="1.05" Duration="0:0:1"
                           AutoReverse="True"
                           EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="HandScaleTransform"
                           Storyboard.TargetProperty="ScaleY"
                           From="1" To="1.05" Duration="0:0:1"
                           AutoReverse="True"
                           EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
        
        <!-- Animation swipe vers la droite -->
        <Storyboard x:Key="SwipeRightAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HandTranslateTransform"
                           Storyboard.TargetProperty="X"
                           From="-60" To="60" Duration="0:0:1"
                           AutoReverse="False"
                           EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="HandEmoji"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.2"
                           BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="HandEmoji"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.2"
                           BeginTime="0:0:0.8"/>
        </Storyboard>
        
        <!-- Animation swipe vers la gauche -->
        <Storyboard x:Key="SwipeLeftAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HandTranslateTransform"
                           Storyboard.TargetProperty="X"
                           From="60" To="-60" Duration="0:0:1"
                           AutoReverse="False"
                           EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="HandEmoji"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.2"
                           BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="HandEmoji"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.2"
                           BeginTime="0:0:0.8"/>
        </Storyboard>
        
        <!-- Animation swipe vers le haut -->
        <Storyboard x:Key="SwipeUpAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HandTranslateTransform"
                           Storyboard.TargetProperty="Y"
                           From="40" To="-40" Duration="0:0:1"
                           AutoReverse="False"
                           EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="HandEmoji"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.2"
                           BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="HandEmoji"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.2"
                           BeginTime="0:0:0.8"/>
        </Storyboard>
        
        <!-- Animation swipe vers le bas -->
        <Storyboard x:Key="SwipeDownAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HandTranslateTransform"
                           Storyboard.TargetProperty="Y"
                           From="-40" To="40" Duration="0:0:1"
                           AutoReverse="False"
                           EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="HandEmoji"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.2"
                           BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="HandEmoji"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.2"
                           BeginTime="0:0:0.8"/>
        </Storyboard>
        
        <!-- Animation pince (clic) -->
        <Storyboard x:Key="PinchAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HandScaleTransform"
                           Storyboard.TargetProperty="ScaleX"
                           From="1" To="0.85" Duration="0:0:0.4"
                           AutoReverse="True"
                           EasingFunction="{StaticResource EaseInOut}"/>
            <DoubleAnimation Storyboard.TargetName="HandScaleTransform"
                           Storyboard.TargetProperty="ScaleY"
                           From="1" To="0.85" Duration="0:0:0.4"
                           AutoReverse="True"
                           EasingFunction="{StaticResource EaseInOut}"/>
        </Storyboard>
    </Window.Resources>
    
    <Grid>
        <!-- Container principal du hint -->
        <Border x:Name="HintContainer" 
                Opacity="0"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            
            <!-- Cadre avec fond semi-transparent -->
            <Border Background="#E6181830"
                    CornerRadius="24"
                    Padding="40,30"
                    BorderBrush="#7c3aed"
                    BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="#7c3aed" BlurRadius="30" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                
                <StackPanel HorizontalAlignment="Center" MaxWidth="400">
                    <!-- Emoji main -->
                    <TextBlock x:Name="HandEmoji"
                               Text="🖐️"
                               FontSize="100"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="HandScaleTransform" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="HandTranslateTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    
                    <!-- Titre du hint -->
                    <TextBlock x:Name="HintTitle"
                               Text="Main ouverte"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    
                    <!-- Description du hint -->
                    <TextBlock x:Name="HintDescription"
                               Text="Gardez la main ouverte pour déplacer le curseur"
                               FontSize="16"
                               Foreground="#d1d5db"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               LineHeight="24"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
