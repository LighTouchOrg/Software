{
  "name": "lightouch",
  "version": "0.0.1",
  "description": "Software used to control the LightTouch system",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win --x64",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "build": {
    "appId": "com.lightouch.app",
    "productName": "LighTouch",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "serveur/**/*"
    ],
    "extraFiles": [
      {
        "from": "serveur",
        "to": "serveur"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/img/lightouch-logo.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LighTouchOrg/Software.git"
  },
  "author": "Jérémy Calosso⁠-⁠Merlino, Benjamin Cottone, Fabien Gelorse, Nathan Tranchant, Arnaud Vitale",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/LighTouchOrg/Software/issues"
  },
  "homepage": "https://github.com/LighTouchOrg/Software#readme",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12",
    "jest": "^30.0.3",
    "jest-environment-jsdom": "^30.0.2",
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "serialport": "^13.0.0"
  }
}
